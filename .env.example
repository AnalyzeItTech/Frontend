# ==============================================================================
# Frontend Environment Configuration (Vercel Deployment)
# ==============================================================================
# Configure this in your Vercel Project Dashboard:
# Settings -> Environment Variables
#
# Production / Render Backend URL:
NEXT_PUBLIC_API_URL=https://your-backend-a.onrender.com

# Google Identity Services (Sign In With Google / One Tap) — public client ID only
# Never put the client secret in the frontend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# LocationIQ Maps — SERVER ONLY (never use NEXT_PUBLIC_ for this).
# The browser loads tiles from /api/map/tiles/*; the key is appended only on the server.
LOCATIONIQ_KEY=
# Optional theme: streets | dark | light
LOCATIONIQ_THEME=streets
