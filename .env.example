# ==============================================================================
# Frontend Environment Configuration (Vercel Deployment)
# ==============================================================================
# Configure this in your Vercel Project Dashboard:
# Settings -> Environment Variables
#
# Production / Render Backend URL:
NEXT_PUBLIC_API_URL=https://your-backend-a.onrender.com

# Google Identity Services (Sign In With Google / One Tap) — public client ID only
# Never put the client secret in the frontend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Google AdSense (free-tier research ads). Premium/Plus never mount ad units (ads_free).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-5383317547226180
# Display unit addunit — also the default in next.config.ts
NEXT_PUBLIC_ADSENSE_SLOT_POST_RUN=7279906325
NEXT_PUBLIC_ADSENSE_SLOT_SESSION=7279906325
NEXT_PUBLIC_ADSENSE_SLOT_VIDEO=
# Optional MP4 for the rewarded watch when AdSense video is not live yet.
NEXT_PUBLIC_HOUSE_AD_VIDEO_URL=

# Post-run ad every N completed queries (free users). Default 8 = best-case cover
# of ~$25/mo at $8 eCPM. Set 3 if remaining infra is closer to $75/mo.
NEXT_PUBLIC_AD_EVERY_N=8

# LocationIQ Maps — SERVER ONLY (never use NEXT_PUBLIC_ for this).
# The browser loads tiles from /api/map/tiles/*; the key is appended only on the server.
LOCATIONIQ_KEY=
# Optional theme: streets | dark | light
LOCATIONIQ_THEME=streets
