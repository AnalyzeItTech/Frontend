{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Scoped least-privilege permissions for AnalyzeIt desktop native client",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "log:default"
  ],
  "remote": {
    "urls": [
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*",
      "https://*.analyzeit.in/*",
      "https://analyzeit.in/*"
    ]
  }
}
